# Copy this file to .env in the backend directory, then change only the values
# needed for your machine. All settings below have the same defaults as config.py.

# Storage paths (absolute paths are recommended when overriding these)
# INDEXES_DIR=../indexes
# RESULTS_DIR=../results

# Retrieval models
EMBED_MODEL=jinaai/jina-embeddings-v2-base-code
EMBED_MODEL_FALLBACK=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBED_DIM=768

# Retrieval behavior
USE_BM25=true
USE_HYBRID=true
USE_RERANK=true
USE_QUERY_CLEAN=true
USE_DOC_NORMALIZE=true
USE_SECOND_PASS=false
USE_VERSION_COLLAPSE=true

# Search limits and ranking
BM25_TOP_K=100
DENSE_TOP_K=100
RRF_K=60
RERANK_TOP_K=30
FINAL_TOP_K=10

# FAISS index configuration
FAISS_INDEX_TYPE=flat
HNSW_M=32
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=50

# Code chunking and embedding
MAX_CHUNK_TOKENS=512
MIN_CHUNK_LINES=3
EMBED_BATCH_SIZE=64
EMBED_MAX_LENGTH=8192

# Cache (Redis is optional; CodeLens falls back to an in-memory cache)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600
QUERY_CACHE_MAX_SIZE=1024
LRU_INDEX_CACHE_SIZE=8

# API server
API_HOST=127.0.0.1
API_PORT=8000
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=120

# Evaluation output
MTEB_TASKS=["AppsRetrieval"]
MTEB_OUTPUT_DIR=results
